{
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.10",
        "slim/twig-view": "^3.4",
        "php-di/php-di": "^7.1",
        "illuminate/database": "^12.62",
        "illuminate/events": "^12.62"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.10",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs:check": "php-cs-fixer check --config=.php-cs-fixer.dist.php --diff --verbose"
    }
}
