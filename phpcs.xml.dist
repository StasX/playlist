<?xml version="1.0"?>
<ruleset
    name="Playlist"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd"
>
    <description>PHP_CodeSniffer configuration for the Playlist project.</description>

    <!-- Standard -->
    <rule ref="PSR12"/>

    <!-- Project directories -->
    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>public</file>

    <!-- Ignore -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>public/css/*</exclude-pattern>
    <exclude-pattern>public/js/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <!-- File extensions -->
    <arg name="extensions" value="php"/>

    <!-- Display -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <!-- PHP version -->
    <config name="php_version" value="80300"/>

    <!-- Encoding -->
    <config name="encoding" value="utf-8"/>
</ruleset>
